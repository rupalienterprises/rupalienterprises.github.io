<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Associate Login | Rupali Enterprises</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        linear-gradient(135deg, #f8faff, #eef2ff);
      color: #172033;
    }

    .login-box {
      width: min(420px, 92%);
      background: white;
      padding: 40px;
      border-radius: 18px;
      box-shadow: 0 15px 50px rgba(23, 32, 51, 0.12);
    }

    .logo {
      font-size: 1.3rem;
      font-weight: 800;
      margin-bottom: 35px;
    }

    .eyebrow {
      color: #4f46e5;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      margin-bottom: 10px;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 10px;
    }

    .description {
      color: #687386;
      margin-bottom: 28px;
    }

    label {
      display: block;
      font-weight: 700;
      margin-bottom: 7px;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #d9deea;
      border-radius: 9px;
      font-size: 1rem;
      margin-bottom: 18px;
    }

    input:focus {
      outline: none;
      border-color: #4f46e5;
    }

    button {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 9px;
      background: #4f46e5;
      color: white;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.9;
    }

    #message {
      margin-top: 18px;
      text-align: center;
      font-size: 0.9rem;
    }

    .back {
      display: block;
      text-align: center;
      margin-top: 22px;
      color: #536075;
      text-decoration: none;
      font-size: 0.9rem;
    }
  </style>
</head>

<body>

  <div class="login-box">

    <div class="logo">
      Rupali Enterprises
    </div>

    <p class="eyebrow">
      ASSOCIATES
    </p>

    <h1>
      Login
    </h1>

    <p class="description">
      Login to access the associates sales dashboard.
    </p>

    <form id="loginForm">

      <label for="username">
        Username
      </label>

      <input
        type="text"
        id="username"
        placeholder="Enter username"
        required
      >

      <label for="password">
        Password
      </label>

      <input
        type="password"
        id="password"
        placeholder="Enter password"
        required
      >

      <button type="submit">
        Login
      </button>

    </form>

    <p id="message"></p>

    <a href="index.html" class="back">
      ← Back to website
    </a>

  </div>

</body>
</html>
