<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Login | Rupali Enterprises</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #eef2ff;
      color: #172033;
    }

    .login-box {
      width: 90%;
      max-width: 400px;
      background: white;
      padding: 35px;
      border-radius: 16px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.12);
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
      margin-bottom: 30px;
    }

    .eyebrow {
      color: #4f46e5;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 2px;
    }

    h1 {
      margin: 8px 0;
    }

    .description {
      color: #667085;
      margin-bottom: 25px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 7px;
    }

    select,
    input {
      width: 100%;
      padding: 13px;
      margin-bottom: 18px;
      border: 1px solid #d0d5dd;
      border-radius: 8px;
      font-size: 16px;
    }

    button {
      width: 100%;
      padding: 14px;
      border: 0;
      border-radius: 8px;
      background: #4f46e5;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.9;
    }

    #message {
      text-align: center;
      margin-top: 15px;
      color: #d92d20;
    }

    .back {
      display: block;
      text-align: center;
      margin-top: 20px;
      color: #667085;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <div class="login-box">

    <div class="logo">
      Rupali Enterprises
    </div>

    <p class="eyebrow">
      ASSOCIATES PORTAL
    </p>

    <h1>Login</h1>

    <p class="description">
      Select your account and enter your password.
    </p>

    <form id="loginForm">

      <label for="role">
        Login as
      </label>

      <select id="role">
        <option value="associate">Associate</option>
        <option value="admin">Admin</option>
      </select>


      <label for="password">
        Password
      </label>

      <input
        type="password"
        id="password"
        placeholder="Enter password"
        required
      >


      <button type="submit">
        Login
      </button>

    </form>

    <p id="message"></p>

    <a href="index.html" class="back">
      ← Back to website
    </a>

  </div>


  <script>

    const AUTH_API =
      "https://script.google.com/macros/s/AKfycbzk0HiOKzatYdgTyf48S8or8VKURzdZVaIFifCq6y6oP8JaFRjyvLss7jTUsvMM8YUl/exec";


    document
      .getElementById("loginForm")
      .addEventListener("submit", async function(e) {

        e.preventDefault();

        const role =
          document.getElementById("role").value;

        const password =
          document.getElementById("password").value;

        const message =
          document.getElementById("message");

        message.textContent = "Checking...";


        try {

          const response = await fetch(AUTH_API, {

            method: "POST",

            headers: {
              "Content-Type": "text/plain;charset=utf-8"
            },

            body: JSON.stringify({
              role: role,
              password: password
            })

          });


          const result =
            await response.json();


          if (result.success) {

            if (result.role === "admin") {

              window.location.href = "admin.html";

            } else {

              window.location.href = "associates.html";

            }

          } else {

            message.textContent =
              "Incorrect password.";

          }

        } catch (error) {

          message.textContent =
            "Unable to connect. Please try again.";

        }

      });

  </script>

</body>
</html>
